# 菜谱生成模型配置（文本生成）
# 开发环境：留空使用 Vite 代理转发到后端（localhost:8080）
# 生产环境：填写后端部署地址，如 https://your-backend.com
VITE_TEXT_GENERATION_BASE_URL=
# API Key 由后端统一管理，前端仅需占位即可
VITE_TEXT_GENERATION_API_KEY=proxy-mode
VITE_TEXT_GENERATION_MODEL=deepseek-chat
VITE_TEXT_GENERATION_TEMPERATURE=0.7
VITE_TEXT_GENERATION_TIMEOUT=300000


# 图片生成模型配置（直接调用智谱 API）
VITE_IMAGE_GENERATION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations
VITE_IMAGE_GENERATION_API_KEY=your-zhipu-api-key
VITE_IMAGE_GENERATION_MODEL=cogview-3-flash
